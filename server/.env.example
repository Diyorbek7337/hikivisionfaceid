# Davomat tizimi sozlamalari. Bu faylni .env nomi bilan nusxalang (ixtiyoriy — standart qiymatlar ishlaydi).

# Port. Bo'sh qoldirilsa: 3000 (band bo'lsa keyingi bo'sh port avtomatik tanlanadi va eslab qolinadi)
PORT=

# Vaqt zonasi
TIMEZONE=Asia/Tashkent

# Ma'lumotlar papkasi (baza va zaxira nusxalar)
DATA_DIR=./data

# Telegram (ixtiyoriy). Bo'sh qoldirilsa xabar yuborilmaydi.
BOT_TOKEN=
# Kunlik hisobot va kechikish xabarlarini oladiganlar (direktor, admin) chat ID lari, vergul bilan
ADMIN_TELEGRAM_IDS=

# Telegram mini ilova (rahbar / HR telefondan ko'rishi uchun). Serverning internetdagi HTTPS manzili,
# masalan Tailscale Funnel: https://maktab-pc.tail1234.ts.net  (README → "Telefondan ko'rish")
PUBLIC_URL=
