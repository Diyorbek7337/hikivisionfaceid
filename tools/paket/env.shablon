# Davomat tizimi sozlamalari. O'zgartirgandan keyin tizimni qayta ishga tushiring.
# Bo'sh qolgan qatorlar ishlatilmaydi.

# Tizim porti (terminallardagi HTTP Listening ham shu portga sozlanadi). O'zgartirmang.
PORT=3001

# Vaqt zonasi
TIMEZONE=Asia/Tashkent

# ---------- Telegram (ixtiyoriy) ----------
# @BotFather -> /newbot bergan token. Har bir tashkilot uchun ALOHIDA bot yarating.
BOT_TOKEN=
# Kunlik hisobot va kechikish xabarlarini oladiganlar (direktor, admin) Telegram ID lari, vergul bilan.
# ID ni bilish: botga /start yozing - bot ID ni aytadi.
ADMIN_TELEGRAM_IDS=

# ---------- Telefondan ko'rish (ixtiyoriy) ----------
# Tailscale Funnel bergan manzil, masalan: https://maktab-pc.tail1234.ts.net
# (administrator cmd: tailscale funnel --bg 3001)
PUBLIC_URL=
