# Server porti
PORT=3000

# Serverning internetdagi manzili, masalan http://hik.example.com
# O'z kompyuteringizda ishlatsangiz BO'SH qoldiring - kompyuterning lokal IP si avtomatik olinadi.
PUBLIC_URL=

# Admin panelga kirish
ADMIN_USERNAME=admin
ADMIN_PASSWORD=kuchli-parol-qoying
# Sessiya kaliti: uzun tasodifiy satr (masalan: openssl rand -hex 32)
SESSION_SECRET=

# Ma'lumotlar bazasi fayli
DB_PATH=./data/davomat.db

# Vaqt zonasi
TIMEZONE=Asia/Tashkent

# Necha daqiqagacha kechikish hisoblanmaydi
LATE_GRACE_MINUTES=5
# Bir xodimning ketma-ket skanlari orasidagi minimal vaqt (soniya)
DEBOUNCE_SECONDS=60

# Telegram (ixtiyoriy). Bo'sh qoldirilsa, xabar yuborilmaydi.
BOT_TOKEN=
# Kechikish haqida xabar oladigan adminlar chat ID lari, vergul bilan
ADMIN_TELEGRAM_IDS=

# docker-compose uchun: server domeni (masalan hik.example.com). DNS A yozuvi server IP siga qarashi kerak.
DOMAIN=
