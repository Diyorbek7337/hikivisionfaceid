rules_version = '2';

// Web app faqat administratorlar uchun. Administratorlar ro'yxati: admins/{uid}
// (ko'prik bridge/.env dagi ADMIN_EMAILS asosida avtomatik to'ldiradi).
// Ko'prik (firebase-admin) bu qoidalardan mustaqil ishlaydi.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Har kim faqat o'zining admin yozuvini o'qiy oladi (web app ruxsatni shunday tekshiradi).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
