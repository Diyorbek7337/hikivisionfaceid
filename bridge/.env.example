# Ko'prik (bridge) sozlamalari. Bu faylni .env nomi bilan nusxalang.

# Web app'ga kira oladigan administratorlar emaili (vergul bilan).
# Avval ularni Firebase Console -> Authentication -> Add user orqali yarating.
ADMIN_EMAILS=

# Port (terminallar va web app shu portga ulanadi)
PORT=3000

# Vaqt zonasi
TIMEZONE=Asia/Tashkent

# Firebase fayllari (odatda o'zgartirish shart emas)
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json
FIREBASE_WEB_CONFIG=./firebase-web-config.json

# Telegram (ixtiyoriy). Bo'sh qoldirilsa xabar yuborilmaydi.
BOT_TOKEN=
# Kechikish haqida xabar oladigan adminlar Telegram chat ID lari, vergul bilan
ADMIN_TELEGRAM_IDS=
