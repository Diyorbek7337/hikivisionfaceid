# Admin panel — HTTPS (sertifikat avtomatik olinadi)
{$DOMAIN} {
	reverse_proxy app:3000
}

# Terminallar oddiy HTTP orqali yuboradi, shuning uchun /hik/* yo'li HTTPS ga
# yo'naltirilmaydi. Qolgan hamma narsa HTTPS ga yo'naltiriladi.
http://{$DOMAIN} {
	handle /hik/* {
		reverse_proxy app:3000
	}
	handle {
		redir https://{host}{uri} permanent
	}
}
